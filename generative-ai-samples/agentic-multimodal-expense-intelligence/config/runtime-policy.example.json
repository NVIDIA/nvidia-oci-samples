  },
  "name": "abc-expense-intelligence-runtime-policy",
  "allowedOutboundHosts": [
    "integrate.api.nvidia.com",
    "build.nvidia.com",
    "localhost",
    "127.0.0.1"
  ],
  "blockedNetworkCalls": ["metadata.google.internal", "169.254.169.254"],
  "toolAllowlist": [
    "trip.create",
    "receipt.store_upload",
    "nemotron.parse",
    "nemotron.omni",
    "receipt.schema_guard_repair",
    "policy.evaluate",
    "csv.export",
    "human.approve"
  ],
  "secretRedaction": {
    "enabled": true,
    "patterns": ["nvapi-[A-Za-z0-9_-]+", "Bearer [A-Za-z0-9._-]+"]
  },
  "humanApprovalRequiredBeforeHandoff": true,
  "modelRoutingPolicy": {
    "parse": "nvidia/nemotron-parse",
    "reasoning": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
    "fallback": "local-deterministic-fixture-evidence"
  }
}
