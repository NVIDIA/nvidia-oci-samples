APP_HOST=127.0.0.1
APP_PORT=8790
MODEL_EXECUTION_MODE=auto

# Hosted NVIDIA / build.nvidia.com compatible key. Required for the default auto/nemotron demo path. MODEL_EXECUTION_MODE=local is only for explicit offline fixture tests.
NVIDIA_API_KEY=

# Optional separate keys for model routing.
NEMOTRON_PARSE_API_KEY=
NEMOTRON_OMNI_API_KEY=

NEMOTRON_PARSE_BASE_URL=https://integrate.api.nvidia.com
NEMOTRON_OMNI_BASE_URL=https://integrate.api.nvidia.com
NEMOTRON_PARSE_MODEL=nvidia/nemotron-parse
NEMOTRON_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
